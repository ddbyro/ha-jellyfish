    "run_custom_pattern": {
      "name": "Run custom pattern",
      "description": "Run an ad-hoc pattern on the targeted zone lights. Unset fields use defaults.",
      "fields": {
        "type": {
          "name": "Pattern type",
          "description": "How colors move: Color (solid), Chase, Paint, Stacker, Sequence, Multi-Paint, Soffit."
        },
        "colors": {
          "name": "Colors",
          "description": "List of RGB colors, e.g. [[255,0,0],[0,0,255]]. Up to 30."
        },
        "brightness": {
          "name": "Brightness",
          "description": "0-100%, as in the JellyFish app."
        },
        "speed": {
          "name": "Speed",
          "description": "0-100. Lower is faster (0/1 fastest)."
        },
        "direction": {
          "name": "Direction",
          "description": "Which way the pattern moves."
        },
        "effect": {
          "name": "Effect",
          "description": "Overlay effect: Twinkle or Lightning."
        },
        "effect_value": {
          "name": "Effect value",
          "description": "Strength of the overlay effect."
        },
        "space_between_pixels": {
          "name": "Space between pixels",
          "description": "Length of each color segment."
        },
        "effect_between_pixels": {
          "name": "Effect between pixels",
          "description": "How adjacent colors blend."
